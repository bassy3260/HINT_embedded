# ── Microchip / Atmel Studio ──────────────────────────────
# IDE 캐시 / 사용자별 설정
.vs/
*.atsuo
*.user

# 빌드 산출물
[Dd]ebug/
[Rr]elease/
*.o
*.d
*.elf
*.hex
*.eep
*.lss
*.map
*.srec

# 자동 생성 파일
*.componentinfo.xml

# ── C 실습 ────────────────────────────────────────────────
*.exe
*.obj
*.ilk
*.pdb
tasks.json

# ── 기타 ──────────────────────────────────────────────────
.DS_Store
Thumbs.db


# ── RTOS ──────────────────────────────────────────────────
RTOS/FreeRTOS-LTS/
embedded linux/face_recognition/

# 프로젝트별 FreeRTOS Source 복사본 (커널 .c / include / portable)
RTOS/freeRTOS_Projects/**/Source/

# ── OTA_Security ──────────────────────────────────────────
# 실습 중 생성되는 산출물은 커밋하지 않음 (코드 .py / 문서 .md 만 관리)
# 펌웨어·암호문·조각 (100MB 파일 포함)
OTA_Security/**/*.bin
OTA_Security/**/*.bin.tmp
OTA_Security/**/*.enc
OTA_Security/**/*.zip
# 해시·서명·매니페스트
OTA_Security/**/*.sha256
OTA_Security/**/*.sig
OTA_Security/**/sig
OTA_Security/**/manifest.json
# 키·인증서 (개인키 유출 방지)
OTA_Security/**/*.pem
OTA_Security/**/*.crt
OTA_Security/**/*.xdb
# 배포/다운로드 폴더
OTA_Security/**/dist/
OTA_Security/**/work/
OTA_Security/**/device/
# 파이썬 캐시
__pycache__/
*.pyc
